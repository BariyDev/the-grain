{
  "name": "the-grain",
  "module": "index.ts",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "validate-branch-name": "^1.3.2"
  },
  "private": true,
  "scripts": {
    "dev": "bun --watch server/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "ci:format": "prettier --check .",
    "prepare": "husky",
    "typecheck": "bun run typecheck:server && bun run typecheck:client",
    "typecheck:server": "tsc --noEmit",
    "typecheck:client": "cd client && bun run typecheck"
  },
  "type": "module",
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "postgres": "^3.4.9"
  }
}
