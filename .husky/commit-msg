#!/bin/sh

RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
CYAN="\033[0;36m"
RESET="\033[0m"

printf "${CYAN}[commit-msg] Validating commit message...${RESET}\n"
if ! bunx --no -- commitlint --edit "$1"; then
  printf "${RED}[commit-msg] Commit message validation failed.${RESET}\n"
  printf "${YELLOW}[commit-msg] Follow the Conventional Commits format: type: subject.${RESET}\n"
  exit 1
fi

printf "${GREEN}[commit-msg] Commit message is valid.${RESET}\n"
